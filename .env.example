DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional stable admin token override. Leave empty to generate a fresh
# in-memory token on every bot restart and retrieve it with !token in bot DMs.
ADMIN_API_TOKEN=

# Optional: use this for fast guild-scoped command registration during development.
DISCORD_GUILD_ID=
DISCORD_COMMAND_REGISTER_SCOPE=global

FULLPARTY_API_BASE_URL=https://api.fullparty.gg
# Needs users:write for user linking and guilds:write for guild linking.
FULLPARTY_API_TOKEN=
FULLPARTY_WEB_BASE_URL=https://fullparty.gg
FULLPARTY_WEBHOOK_SIGNING_SECRET=

DATABASE_PATH=data/fullparty-discord-bot.sqlite
BOT_FAILURE_LOG_PATH=data/fullparty-discord-bot-failures.jsonl

# Guild automation queue pacing. Keep this conservative unless Discord API
# pressure is clearly low.
GUILD_AUTOMATION_QUEUE_CONCURRENCY=2
GUILD_AUTOMATION_QUEUE_POLL_INTERVAL_MS=1000

# Guild member adoption cache. The bot refreshes server member IDs in the
# background; dashboard requests should read this cache instead of fetching live.
GUILD_MEMBER_CACHE_CONCURRENCY=1
GUILD_MEMBER_CACHE_REFRESH_INTERVAL_MS=86400000
GUILD_MEMBER_CACHE_SWEEP_INTERVAL_MS=300000
GUILD_MEMBER_CACHE_PURGE_AFTER_MS=604800000
GUILD_MEMBER_CACHE_RETRY_AFTER_MS=900000

HTTP_HOST=0.0.0.0
HTTP_PORT=3000

LOG_LEVEL=info

# Runtime console log archive. The admin Log tab shows the newest lines, and
# these files retain console output for the configured number of days.
RUNTIME_LOG_DIRECTORY=data/runtime-logs
RUNTIME_LOG_RETENTION_DAYS=30

# Optional: Discord user ID allowed to use /payload.
# Leave empty to deny /payload to everyone.
PAYLOAD_COMMAND_ALLOWED_USER_ID=

# User DM pacing. Defaults to no more than 2 DMs per user per 5 minutes.
USER_DM_RATE_LIMIT_COUNT=2
USER_DM_RATE_LIMIT_WINDOW_MS=300000
