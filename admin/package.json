{
  "name": "@fullparty/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./contracts": {
      "types": "./dist/shared/contracts.d.ts",
      "import": "./dist/shared/contracts.js"
    },
    "./schemas": {
      "types": "./dist/shared/schemas.d.ts",
      "import": "./dist/shared/schemas.js"
    }
  },
  "scripts": {
    "dev": "vite --config ui/vite.config.ts",
    "preview": "vite preview --config ui/vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && vue-tsc -p ui/tsconfig.json --noEmit",
    "build": "npm run build:server && vue-tsc -p ui/tsconfig.json --noEmit && vite build --config ui/vite.config.ts",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "apexcharts": "^5.13.0",
    "vue": "^3.5.24",
    "vue3-apexcharts": "^1.11.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.3",
    "vite": "^7.2.4"
  }
}
