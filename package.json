{
  "name": "fullparty-discord-bot",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "admin"
  ],
  "type": "module",
  "description": "Discord.js management bot for Fullparty.gg.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "preview:discord": "node scripts/discord-preview/build.mjs && node scripts/discord-preview/serve.mjs",
    "preview:discord:test": "node --test scripts/discord-preview/workshop.test.mjs",
    "admin:build": "npm run build --workspace @fullparty/admin",
    "admin:build:server": "npm run build:server --workspace @fullparty/admin",
    "admin:dev": "npm run dev --workspace @fullparty/admin",
    "admin:preview": "npm run preview --workspace @fullparty/admin",
    "predev": "npm run build",
    "dev": "node --env-file-if-exists=.env dist/index.js",
    "dev:build": "npm run dev",
    "predev:watch": "npm run admin:build",
    "dev:watch": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "npm run admin:build && tsc -p tsconfig.build.json",
    "build:bot": "npm run admin:build:server && tsc -p tsconfig.build.json",
    "typecheck": "npm run admin:build:server && tsc --noEmit && npm run typecheck --workspace @fullparty/admin",
    "pretest": "npm run admin:build:server",
    "test": "vitest run && npm run test --workspace @fullparty/admin",
    "pretest:watch": "npm run admin:build:server",
    "test:watch": "vitest",
    "precoverage": "npm run admin:build:server",
    "coverage": "vitest run --coverage && npm run test --workspace @fullparty/admin",
    "prelint": "npm run admin:build:server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commands:deploy": "tsx src/application/deployCommands.ts",
    "commands:deploy:global": "tsx src/application/deployCommands.ts --global",
    "commands:deploy:guild": "tsx src/application/deployCommands.ts --guild"
  },
  "dependencies": {
    "@fullparty/admin": "0.1.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.4.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
