{
  "name": "fullparty-discord-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discord.js management bot for Fullparty.gg.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node dist/index.js",
    "dev:build": "npm run build && node dist/index.js",
    "dev:watch": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commands:deploy": "tsx src/application/deployCommands.ts",
    "commands:deploy:global": "tsx src/application/deployCommands.ts --global",
    "commands:deploy:guild": "tsx src/application/deployCommands.ts --guild"
  },
  "dependencies": {
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  }
}
